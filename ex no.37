#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[20], n, head, i;
    int movement = 0, distance;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nSeek Sequence: %d", head);

    for(i = 0; i < n; i++)
    {
        distance = abs(request[i] - head);
        movement += distance;
        head = request[i];

        printf(" -> %d", head);
    }

    printf("\nTotal Head Movement = %d\n", movement);

    return 0;
}
