#include <stdio.h>

int main()
{
    int block[3] = {100, 200, 300};
    int process[3] = {80, 150, 250};
    int i;

    for(i = 0; i < 3; i++)
    {
        if(process[i] <= block[i])
            printf("Process %d allocated to Block %d\n", i+1, i+1);
        else
            printf("Process %d not allocated\n", i+1);
    }

    return 0;
}
