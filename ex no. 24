#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd;
    char msg[] = "Hello OS Lab";

    fd = creat("sample.txt", 0666);

    if(fd < 0)
    {
        printf("File creation failed\n");
        return 1;
    }

    write(fd, msg, strlen(msg));
    close(fd);

    printf("File created and data written successfully\n");

    return 0;
}
