#include <stdio.h>
#include <stdlib.h>

int main()
{
    int req[20], n, head, size, dir;
    int i, j, temp, movement = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &size);

    printf("Enter direction (1=Right, 0=Left): ");
    scanf("%d", &dir);

    for(i = 0; i < n - 1; i++)
        for(j = i + 1; j < n; j++)
            if(req[i] > req[j])
            {
                temp = req[i];
                req[i] = req[j];
                req[j] = temp;
            }

    printf("\nSeek Sequence: %d", head);

    if(dir == 1)
    {
        for(i = 0; i < n; i++)
            if(req[i] >= head)
            {
                movement += abs(head - req[i]);
                head = req[i];
                printf(" -> %d", head);
            }

        movement += abs(head - (size - 1));
        head = size - 1;
        printf(" -> %d", head);

        for(i = n - 1; i >= 0; i--)
            if(req[i] < head)
            {
                movement += abs(head - req[i]);
                head = req[i];
                printf(" -> %d", head);
            }
    }
    else
    {
        for(i = n - 1; i >= 0; i--)
            if(req[i] <= head)
            {
                movement += abs(head - req[i]);
                head = req[i];
                printf(" -> %d", head);
            }

        movement += abs(head);
        head = 0;
        printf(" -> %d", head);

        for(i = 0; i < n; i++)
            if(req[i] > head)
            {
                movement += abs(head - req[i]);
                head = req[i];
                printf(" -> %d", head);
            }
    }

    printf("\nTotal Head Movement = %d\n", movement);

    return 0;
}
