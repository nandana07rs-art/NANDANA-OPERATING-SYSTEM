#include <stdio.h>

int main()
{
    int n, i, j, bt[10], pr[10], p[10], temp;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Burst Time and Priority:\n");
    for(i = 0; i < n; i++)
    {
        p[i] = i + 1;
        scanf("%d%d", &bt[i], &pr[i]);
    }

    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(pr[i] > pr[j])
            {
                temp = pr[i];
                pr[i] = pr[j];
                pr[j] = temp;

                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;

                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    printf("\nProcess\tBurst Time\tPriority\n");
    for(i = 0; i < n; i++)
        printf("P%d\t%d\t\t%d\n", p[i], bt[i], pr[i]);

    return 0;
}
