#include <stdio.h>
#include <pthread.h>

void *display(void *arg)
{
    printf("Thread %ld is executing\n", (long)arg);
    pthread_exit(NULL);
}

int main()
{
    pthread_t t1, t2;

    pthread_create(&t1, NULL, display, (void *)1);
    pthread_create(&t2, NULL, display, (void *)2);

    if (pthread_equal(t1, t2))
        printf("Threads are Equal\n");
    else
        printf("Threads are Not Equal\n");

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    printf("Threads Joined Successfully\n");

    return 0;
}
