#include <stdio.h>

int main()
{
    int i, j, users, files;
    char name[10][10], file[10][10];

    printf("Enter number of users: ");
    scanf("%d", &users);

    for(i = 0; i < users; i++)
    {
        printf("Enter user name: ");
        scanf("%s", name[i]);

        printf("Enter number of files: ");
        scanf("%d", &files);

        for(j = 0; j < files; j++)
        {
            printf("Enter file %d: ", j + 1);
            scanf("%s", file[j]);
        }

        printf("\nUser: %s\n", name[i]);
        for(j = 0; j < files; j++)
            printf("%s\n", file[j]);
    }

    return 0;
}
