#include <stdio.h>

int main()
{
    int blockSize[10], processSize[10];
    int allocation[10], m, n, i, j, worst;

    printf("Enter number of blocks: ");
    scanf("%d", &m);

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter block sizes:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &blockSize[i]);

    printf("Enter process sizes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &processSize[i]);

    for(i = 0; i < n; i++)
    {
        allocation[i] = -1;
        worst = -1;

        for(j = 0; j < m; j++)
        {
            if(blockSize[j] >= processSize[i])
            {
                if(worst == -1 || blockSize[j] > blockSize[worst])
                    worst = j;
            }
        }

        if(worst != -1)
        {
            allocation[i] = worst;
            blockSize[worst] -= processSize[i];
        }
    }

    printf("\nProcess\tBlock\n");
    for(i = 0; i < n; i++)
    {
        printf("%d\t", i + 1);
        if(allocation[i] != -1)
            printf("%d\n", allocation[i] + 1);
        else
            printf("Not Allocated\n");
    }

    return 0;
}
