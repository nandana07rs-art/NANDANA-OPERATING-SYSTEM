#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t mutex;

void *reader(void *arg)
{
    sem_wait(&mutex);
    printf("Reader is reading...\n");
    sem_post(&mutex);
    return NULL;
}

void *writer(void *arg)
{
    sem_wait(&mutex);
    printf("Writer is writing...\n");
    sem_post(&mutex);
    return NULL;
}

int main()
{
    pthread_t r, w;

    sem_init(&mutex, 0, 1);

    pthread_create(&r, NULL, reader, NULL);
    pthread_create(&w, NULL, writer, NULL);

    pthread_join(r, NULL);
    pthread_join(w, NULL);

    sem_destroy(&mutex);

    return 0;
}
